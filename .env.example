# Copy to .env and fill in for local development.
# For EAS Build, set secrets with: eas secret:create --name KEY --value "..."

# Expo EAS project (from eas build:configure or expo.dev)
# EAS_PROJECT_ID=your-eas-project-id

# Supabase (if using env in app)
# EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (used by src/services/ai.ts — never commit .env)
# OPENAI_API_KEY=sk-xxxxx
# Or for Expo client: EXPO_PUBLIC_OPENAI_API_KEY=sk-xxxxx
